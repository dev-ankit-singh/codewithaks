<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add/Edit FAQ – AKS Admin</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;}
        :root{--sidebar-w:240px;--bg:#0d0d14;--sidebar:#0f0f1a;--surface:#16162a;--surface2:#1a1a2e;--border:rgba(255,255,255,0.07);--primary:#4f46e5;--accent:#7c3aed;--text:#f1f1f1;--muted:#9ca3af;}
        body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;margin:0;}
        .sidebar{width:var(--sidebar-w);background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:24px 0;position:fixed;top:0;left:0;bottom:0;z-index:100;}
        .sidebar-brand{padding:0 20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
        .sidebar-brand .icon{width:36px;height:36px;background:linear-gradient(135deg,var(--primary),var(--accent));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;}
        .sidebar-brand span{font-family:'Outfit',sans-serif;font-size:16px;font-weight:700;}
        .sidebar-nav{padding:16px 12px;flex:1;overflow-y:auto;}
        .nav-label{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:1px;padding:0 8px;margin:16px 0 6px;}
        .nav-item a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;transition:all .15s;}
        .nav-item a:hover,.nav-item a.active{background:rgba(79,70,229,.15);color:#a5b4fc;}
        .nav-item a i{width:18px;text-align:center;}
        .sidebar-footer{padding:16px 12px;border-top:1px solid var(--border);}
        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:#fca5a5;text-decoration:none;font-size:14px;font-weight:500;transition:background .15s;}
        .logout-btn:hover{background:rgba(239,68,68,.1);}
        .main-content{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-width:0;}
        .topbar{background:rgba(13,13,20,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;}
        .topbar h2{font-size:18px;font-weight:600;font-family:'Outfit',sans-serif;margin:0;}
        .page-body{padding:28px;}
        .card-panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:24px;}
        .panel-title{font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;margin:0 0 20px;display:flex;align-items:center;gap:8px;}
        .panel-title i{color:#818cf8;}
        .form-label{font-size:13px;font-weight:500;color:var(--muted);margin-bottom:6px;}
        .form-control,.form-select{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:10px;font-size:14px;padding:10px 14px;}
        .form-control:focus,.form-select:focus{background:var(--surface2);border-color:rgba(79,70,229,.5);color:var(--text);box-shadow:0 0 0 3px rgba(79,70,229,.12);}
        .form-control::placeholder{color:var(--muted);}
        .form-select option{background:#1a1a2e;color:var(--text);}
        .btn-primary-admin{background:linear-gradient(135deg,var(--primary),var(--accent));border:none;color:#fff;padding:10px 22px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:opacity .2s;display:inline-flex;align-items:center;gap:7px;}
        .btn-primary-admin:hover{opacity:.85;}
        .btn-secondary-admin{background:var(--surface2);border:1px solid var(--border);color:var(--muted);padding:9px 18px;border-radius:10px;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;}
        .btn-secondary-admin:hover{border-color:rgba(79,70,229,.4);color:#a5b4fc;}
        .alert-msg{padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:16px;display:none;}
        .alert-success{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#34d399;}
        .alert-error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;}
        .ql-toolbar.ql-snow,.ql-container.ql-snow{border-color:var(--border) !important;background:var(--surface2);}
        .ql-toolbar.ql-snow{border-radius:10px 10px 0 0;}
        .ql-container.ql-snow{border-radius:0 0 10px 10px;min-height:180px;}
        .ql-editor{color:var(--text);font-size:14px;}
        .ql-snow .ql-stroke{stroke:#9ca3af;}
        .ql-snow .ql-fill{fill:#9ca3af;}
        .ql-snow .ql-picker{color:#9ca3af;}
        .schema-card {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 14px;
        }
        .schema-card-header {
            padding: 10px 16px;
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .8px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .schema-card-body {
            padding: 16px;
        }
        .form-check-input {
            background-color: var(--surface2);
            border-color: var(--border);
        }
        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }
        .form-check-label {
            color: var(--muted);
            font-size: 13px;
        }
        @media(max-width:768px){
            .sidebar{transform:translateX(-100%);transition:transform .3s;}
            .sidebar.open{transform:translateX(0);}
            .main-content{margin-left:0;}
            .page-body{padding:16px;}
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
            <span>AKS Admin</span>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Management</div>
            <div class="nav-item"><a href="/dhanrubi/dashboard"><i class="fa-solid fa-gauge"></i> Dashboard</a></div>
            <div class="nav-item"><a href="/dhanrubi/blogs"><i class="fa-solid fa-newspaper"></i> All Posts</a></div>
            <div class="nav-item"><a href="/dhanrubi/add_blog"><i class="fa-solid fa-circle-plus"></i> New Post</a></div>
            <div class="nav-item"><a href="/dhanrubi/contacts"><i class="fa-solid fa-envelope"></i> Contacts <% if (locals.unreadContactsCount > 0) { %><span style="background:#ef4444;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:10px;margin-left:auto;"><%= unreadContactsCount %></span><% } %></a></div>
            <div class="nav-item"><a href="/dhanrubi/faqs/list"><i class="fa-solid fa-list-ul"></i> All FAQs</a></div>
            <div class="nav-item"><a href="/dhanrubi/faqs" class="active"><i class="fa-solid fa-circle-plus"></i> New FAQ</a></div>
            <div class="nav-item"><a href="/dhanrubi/analytics"><i class="fa-solid fa-chart-line"></i> Analytics</a></div>
            <div class="nav-label">Account</div>
            <div class="nav-item"><a href="/dhanrubi/change-password"><i class="fa-solid fa-key"></i> Change Password</a></div>
            <div class="nav-label">Website</div>
            <div class="nav-item"><a href="/" target="_blank"><i class="fa-solid fa-globe"></i> View Site</a></div>
            <div class="nav-item"><a href="/faqs" target="_blank"><i class="fa-solid fa-circle-question"></i> View FAQs</a></div>
        </nav>
        <div class="sidebar-footer">
            <a href="/dhanrubi/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
        </div>
    </aside>

    <div class="main-content">
        <div class="topbar">
            <h2><i class="fa-solid fa-circle-plus" style="color:#818cf8;margin-right:8px;"></i>FAQ Form</h2>
            <a href="/dhanrubi/faqs/list" style="font-size:13px;color:var(--muted);text-decoration:none;"><i class="fa-solid fa-arrow-left"></i> Back to FAQ List</a>
        </div>

        <div class="page-body">
            <div id="alertBox" class="alert-msg"></div>

            <!-- ADD / EDIT FORM -->
            <form id="faqForm">
                <div class="card-panel">
                    <div class="panel-title"><i class="fa-solid fa-plus-circle"></i> <span id="formTitle">Add New FAQ</span></div>
                    <input type="hidden" id="editId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            <select class="form-select" id="faqCategory" required>
                                <option value="">-- Select Category --</option>
                                <option>AI &amp; LLM SEO</option>
                                <option>Entity &amp; Semantic SEO</option>
                                <option>Technical SEO</option>
                                <option>Content &amp; EEAT</option>
                                <option>Schema &amp; Structured Data SEO</option>
                                <option>Advanced SEO Concepts</option>
                                <option value="__custom__">+ Custom Category</option>
                            </select>
                            <input type="text" class="form-control mt-2" id="faqCategoryCustom" placeholder="Enter custom category..." style="display:none;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" id="faqStatus">
                                <option value="Published">Published</option>
                                <option value="Draft">Draft</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Question *</label>
                            <textarea class="form-control" id="faqQuestion" rows="2" placeholder="Enter the FAQ question..." required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Slug (auto-generated if empty)</label>
                            <input type="text" class="form-control" id="faqSlug" placeholder="e.g. what-is-llm-seo">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tags (comma-separated)</label>
                            <input type="text" class="form-control" id="faqTags" placeholder="SEO, AI, LLM">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Answer *</label>
                            <div id="quillEditor"></div>
                            <input type="hidden" id="faqAnswer">
                        </div>
                    </div>
                </div>

                <!-- Breadcrumb Schema Markup (aligned with Blog) -->
                <div class="card-panel">
                    <div class="panel-title"><i class="fa-solid fa-code"></i> Schema Markup</div>
                    <div class="schema-card">
                        <div class="schema-card-header"><i class="fa-solid fa-sitemap"></i> Breadcrumb Schema</div>
                        <div class="schema-card-body">
                            <p style="font-size:13px;color:var(--muted);margin-bottom:10px;">Auto-generated: Home › FAQs › FAQ Title</p>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="enableBreadcrumb" checked>
                                <label class="form-check-label" for="enableBreadcrumb">Enable Breadcrumb Schema</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="text-align:right;padding-bottom:40px;">
                    <button type="submit" class="btn-primary-admin" id="saveBtn">
                        <i class="fa-solid fa-floppy-disk"></i> Save FAQ
                    </button>
                    <button type="button" class="btn-secondary-admin" onclick="cancelEdit()" id="cancelBtn" style="display:none;">
                        <i class="fa-solid fa-xmark"></i> Cancel Edit
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        const quill = new Quill('#quillEditor', {
            theme: 'snow',
            modules: { toolbar: [
                [{ header: [2,3,false] }],
                ['bold','italic','underline'],
                [{ list:'ordered' },{ list:'bullet' }],
                ['link','clean']
            ]},
            placeholder: 'Write a detailed answer...'
        });

        // Custom category toggle
        document.getElementById('faqCategory').addEventListener('change', function() {
            document.getElementById('faqCategoryCustom').style.display = this.value === '__custom__' ? 'block' : 'none';
            if (this.value === '__custom__') {
                document.getElementById('faqCategoryCustom').required = true;
            } else {
                document.getElementById('faqCategoryCustom').required = false;
            }
        });

        // Auto-generate slug from Question (on input, only for new FAQ)
        function generateSlug() {
            const editId = document.getElementById('editId').value;
            if (editId) return; // Fixed: slug stays fixed even if title/question is edited

            const q = document.getElementById('faqQuestion').value;
            const s = q.toLowerCase()
                .trim()
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');

            document.getElementById('faqSlug').value = s;
        }

        document.getElementById('faqQuestion').addEventListener('input', generateSlug);

        function showAlert(msg, type) {
            const box = document.getElementById('alertBox');
            box.textContent = msg;
            box.className = 'alert-msg ' + (type === 'success' ? 'alert-success' : 'alert-error');
            box.style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => { box.style.display = 'none'; }, 4000);
        }

        // Cancel Edit Redirect
        function cancelEdit() {
            window.location.href = '/dhanrubi/faqs/list';
        }

        // Edit Mode Initialization
        const urlParams = new URLSearchParams(window.location.search);
        const editId = urlParams.get('id');

        if (editId) {
            document.getElementById('editId').value = editId;
            document.getElementById('formTitle').textContent = 'Edit FAQ';
            document.getElementById('saveBtn').innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Update FAQ';
            document.getElementById('cancelBtn').style.display = 'inline-flex';
            fetchFaqData(editId);
        }

        async function fetchFaqData(id) {
            try {
                const res = await fetch('/api/dhanrubi/faq/' + id, { credentials: 'same-origin' });
                const data = await res.json();
                if (!data.success) { showAlert('Could not load FAQ', 'error'); return; }
                const f = data.faq;
                document.getElementById('faqStatus').value = f.status || 'Published';
                document.getElementById('faqSlug').value = f.slug || '';
                document.getElementById('faqTags').value = (f.tags || []).join(', ');
                document.getElementById('faqQuestion').value = f.question;

                // Category
                const catSel = document.getElementById('faqCategory');
                const opts = Array.from(catSel.options).map(o => o.value);
                if (opts.includes(f.category)) {
                    catSel.value = f.category;
                    document.getElementById('faqCategoryCustom').style.display = 'none';
                } else {
                    catSel.value = '__custom__';
                    document.getElementById('faqCategoryCustom').style.display = 'block';
                    document.getElementById('faqCategoryCustom').value = f.category;
                    document.getElementById('faqCategoryCustom').required = true;
                }

                quill.root.innerHTML = f.answer || '';
                
                // Breadcrumbs checkbox
                const bcData = JSON.parse(f.breadcrumbSchema || '[]');
                document.getElementById('enableBreadcrumb').checked = bcData.length > 0;
            } catch(e) { showAlert('Error loading FAQ', 'error'); }
        }

        // Form Submit
        document.getElementById('faqForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const editId = document.getElementById('editId').value;
            const catSel = document.getElementById('faqCategory').value;
            const category = catSel === '__custom__'
                ? document.getElementById('faqCategoryCustom').value.trim()
                : catSel;
            const question = document.getElementById('faqQuestion').value.trim();
            const answerHtml = quill.root.innerHTML.trim();
            const status = document.getElementById('faqStatus').value;
            const slug = document.getElementById('faqSlug').value.trim();
            const tags = document.getElementById('faqTags').value.trim();

            if (!category) { showAlert('Please select or enter a category.', 'error'); return; }
            if (!question) { showAlert('Question is required.', 'error'); return; }
            if (!answerHtml || answerHtml === '<p><br></p>') { showAlert('Answer is required.', 'error'); return; }

            const enableBreadcrumb = document.getElementById('enableBreadcrumb').checked;
            const breadcrumbData = enableBreadcrumb
                ? JSON.stringify([{ name: 'Home', url: 'https://codewithaks.in/' }, { name: 'FAQs', url: 'https://codewithaks.in/faqs/' }, { name: question, url: `https://codewithaks.in/faqs/${slug}` }])
                : '[]';

            const payload = { category, question, answer: answerHtml, status, slug, tags, breadcrumbSchema: breadcrumbData, _csrf: csrf };
            const url = editId ? '/api/dhanrubi/faq/update/' + editId : '/api/dhanrubi/faq/add';

            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'csrf-token': csrf },
                    body: JSON.stringify(payload),
                    credentials: 'same-origin'
                });
                const data = await res.json();
                if (data.success) {
                    showAlert(data.message || 'FAQ saved successfully!', 'success');
                    setTimeout(() => {
                        window.location.href = '/dhanrubi/faqs/list';
                    }, 1000);
                } else {
                    showAlert(data.message || 'Error saving FAQ.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> ${editId ? 'Update FAQ' : 'Save FAQ'}`;
                }
            } catch(e) {
                showAlert('Network error. Please try again.', 'error');
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> ${editId ? 'Update FAQ' : 'Save FAQ'}`;
            }
        });
    </script>
</body>
</html>
