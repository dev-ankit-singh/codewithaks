<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage FAQs – AKS Admin</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;}
        :root{--sidebar-w:240px;--bg:#0d0d14;--sidebar:#0f0f1a;--surface:#16162a;--surface2:#1a1a2e;--border:rgba(255,255,255,0.07);--primary:#4f46e5;--accent:#7c3aed;--text:#f1f1f1;--muted:#9ca3af;}
        body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;margin:0;}
        .sidebar{width:var(--sidebar-w);background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:24px 0;position:fixed;top:0;left:0;bottom:0;z-index:100;}
        .sidebar-brand{padding:0 20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
        .sidebar-brand .icon{width:36px;height:36px;background:linear-gradient(135deg,var(--primary),var(--accent));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;}
        .sidebar-brand span{font-family:'Outfit',sans-serif;font-size:16px;font-weight:700;}
        .sidebar-nav{padding:16px 12px;flex:1;overflow-y:auto;}
        .nav-label{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:1px;padding:0 8px;margin:16px 0 6px;}
        .nav-item a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;transition:all .15s;}
        .nav-item a:hover,.nav-item a.active{background:rgba(79,70,229,.15);color:#a5b4fc;}
        .nav-item a i{width:18px;text-align:center;}
        .sidebar-footer{padding:16px 12px;border-top:1px solid var(--border);}
        .logout-btn{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:#fca5a5;text-decoration:none;font-size:14px;font-weight:500;transition:background .15s;}
        .logout-btn:hover{background:rgba(239,68,68,.1);}
        .main-content{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-width:0;}
        .topbar{background:rgba(13,13,20,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;}
        .topbar h2{font-size:18px;font-weight:600;font-family:'Outfit',sans-serif;margin:0;}
        .page-body{padding:28px;}
        .card-panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:24px;}
        .panel-title{font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;margin:0 0 20px;display:flex;align-items:center;gap:8px;}
        .panel-title i{color:#818cf8;}
        .btn-new{background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
        .stats-pills{display:flex;gap:10px;font-size:12px;color:var(--muted);margin-bottom:18px;}
        .pill{background:rgba(255,255,255,.06);padding:4px 12px;border-radius:100px;}
        .pill span{color:var(--text);font-weight:600;}
        .search-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
        .search-bar input,.search-bar select{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:7px 12px;font-size:13px;outline:none;}
        .search-bar input:focus,.search-bar select:focus{border-color:var(--primary);}
        .search-bar select option{background:#1a1a2e;}
        .faq-table{width:100%;border-collapse:collapse;font-size:13px;}
        .faq-table th{padding:12px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;border-bottom:1px solid var(--border);}
        .faq-table td{padding:13px 14px;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle;}
        .faq-table tr:hover td{background:rgba(79,70,229,.05);}
        .status-badge{padding:3px 10px;border-radius:100px;font-size:11px;font-weight:600;}
        .status-pub{background:rgba(16,185,129,.12);color:#34d399;}
        .status-draft{background:rgba(245,158,11,.12);color:#fbbf24;}
        .action-btn-sm{padding:5px 10px;border-radius:7px;font-size:12px;text-decoration:none;border:none;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:opacity .15s;}
        .action-btn-sm:hover{opacity:.8;}
        .btn-edit{background:rgba(79,70,229,.15);color:#a5b4fc;}
        .btn-toggle-pub{background:rgba(16,185,129,.15);color:#34d399;}
        .btn-toggle-draft{background:rgba(245,158,11,.15);color:#fbbf24;}
        .btn-view{background:rgba(16,185,129,.12);color:#34d399;}
        .btn-del{background:rgba(239,68,68,.12);color:#fca5a5;}
        .alert-msg{padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:16px;display:none;}
        .alert-success{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#34d399;}
        .alert-error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;}
        .empty-state{text-align:center;padding:48px;color:var(--muted);}
        .empty-state i{font-size:40px;opacity:.3;margin-bottom:12px;}
        .q-trunc{max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        @media(max-width:768px){
            .sidebar{transform:translateX(-100%);transition:transform .3s;}
            .sidebar.open{transform:translateX(0);}
            .main-content{margin-left:0;}
            .page-body{padding:16px;}
            .faq-table{display:block;overflow-x:auto;}
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
            <span>AKS Admin</span>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Management</div>
            <div class="nav-item"><a href="/dhanrubi/dashboard"><i class="fa-solid fa-gauge"></i> Dashboard</a></div>
            <div class="nav-item"><a href="/dhanrubi/blogs"><i class="fa-solid fa-newspaper"></i> All Posts</a></div>
            <div class="nav-item"><a href="/dhanrubi/add_blog"><i class="fa-solid fa-circle-plus"></i> New Post</a></div>
            <div class="nav-item"><a href="/dhanrubi/contacts"><i class="fa-solid fa-envelope"></i> Contacts <% if (locals.unreadContactsCount > 0) { %><span style="background:#ef4444;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:10px;margin-left:auto;"><%= unreadContactsCount %></span><% } %></a></div>
            <div class="nav-item"><a href="/dhanrubi/faqs/list" class="active"><i class="fa-solid fa-list-ul"></i> All FAQs</a></div>
            <div class="nav-item"><a href="/dhanrubi/faqs"><i class="fa-solid fa-circle-plus"></i> New FAQ</a></div>
            <div class="nav-item"><a href="/dhanrubi/analytics"><i class="fa-solid fa-chart-line"></i> Analytics</a></div>
            <div class="nav-label">Account</div>
            <div class="nav-item"><a href="/dhanrubi/change-password"><i class="fa-solid fa-key"></i> Change Password</a></div>
            <div class="nav-label">Website</div>
            <div class="nav-item"><a href="/" target="_blank"><i class="fa-solid fa-globe"></i> View Site</a></div>
            <div class="nav-item"><a href="/faqs" target="_blank"><i class="fa-solid fa-circle-question"></i> View FAQs</a></div>
        </nav>
        <div class="sidebar-footer">
            <a href="/dhanrubi/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
        </div>
    </aside>

    <div class="main-content">
        <div class="topbar">
            <h2><i class="fa-solid fa-list" style="color:#818cf8;margin-right:8px;"></i>All FAQs</h2>
            <a href="/dhanrubi/faqs" class="btn-new"><i class="fa-solid fa-plus"></i> New FAQ</a>
        </div>

        <div class="page-body">
            <div id="alertBox" class="alert-msg"></div>

            <div class="card-panel">
                <div class="stats-pills">
                    <div class="pill">All: <span id="countAll">-</span></div>
                    <div class="pill">Published: <span id="countPublished">-</span></div>
                    <div class="pill">Drafts: <span id="countDrafts">-</span></div>
                </div>

                <div class="search-bar">
                    <input type="search" id="searchFaqs" placeholder="🔍 Search FAQs..." oninput="handleSearch()">
                    <select id="filterStatus" onchange="filterTable()">
                        <option value="">All Statuses</option>
                        <option value="Published">Published</option>
                        <option value="Draft">Draft</option>
                    </select>
                </div>

                <div style="overflow-x:auto;">
                    <table class="faq-table" id="faqTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Question</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="faqTbody">
                            <tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-circle-question fa-spin"></i><p>Loading FAQs...</p></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        let allFaqs = [];
        let searchTimeout;

        async function loadFaqs() {
            try {
                const res = await fetch('/api/dhanrubi/faqs', { credentials: 'same-origin' });
                const data = await res.json();
                if (!data.success) { showAlert('Failed to load FAQs', 'error'); return; }
                allFaqs = data.faqs;
                renderTable(allFaqs);
            } catch(e) { showAlert('Network error loading FAQs', 'error'); }
        }

        function renderTable(faqs) {
            const tbody = document.getElementById('faqTbody');
            if (!faqs.length) {
                tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-circle-question"></i><p>No FAQs found</p></div></td></tr>';
                return;
            }

            tbody.innerHTML = faqs.map((f, i) => `
                <tr id="row-${f._id}">
                    <td style="color:var(--muted);font-size:12px;">${i+1}</td>
                    <td><span style="font-size:12px;background:rgba(79,70,229,.12);color:#a5b4fc;padding:3px 8px;border-radius:6px;">${escHtml(f.category)}</span></td>
                    <td><div class="q-trunc" title="${escHtml(f.question)}">${escHtml(f.question)}</div></td>
                    <td><span class="status-badge ${f.status === 'Published' ? 'status-pub' : 'status-draft'}" id="badge-${f._id}">${f.status}</span></td>
                    <td style="color:var(--muted);font-size:12px;">${new Date(f.createdAt).toLocaleDateString('en-IN')}</td>
                    <td style="white-space:nowrap;display:flex;gap:5px;flex-wrap:wrap;">
                        <a href="/dhanrubi/faqs?id=${f._id}" class="action-btn-sm btn-edit"><i class="fa-solid fa-pen"></i> Edit</a>
                        <button class="action-btn-sm ${f.status === 'Published' ? 'btn-toggle-draft' : 'btn-toggle-pub'} toggle-btn" data-id="${f._id}" id="toggle-${f._id}"><i class="fa-solid fa-toggle-on"></i> ${f.status === 'Published' ? 'Draft' : 'Publish'}</button>
                        <a href="/faqs/${f.slug}" target="_blank" class="action-btn-sm btn-view"><i class="fa-solid fa-eye"></i></a>
                        <button class="action-btn-sm btn-del delete-btn" data-id="${f._id}"><i class="fa-solid fa-trash"></i> Delete</button>
                    </td>
                </tr>`).join('');

            document.getElementById('countAll').textContent = allFaqs.length;
            document.getElementById('countPublished').textContent = allFaqs.filter(f => f.status === 'Published').length;
            document.getElementById('countDrafts').textContent = allFaqs.filter(f => f.status === 'Draft').length;
        }

        function handleSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(filterTable, 400);
        }

        function filterTable() {
            const q = document.getElementById('searchFaqs').value.toLowerCase().trim();
            const status = document.getElementById('filterStatus').value;

            let filtered = allFaqs;
            if (status) {
                filtered = filtered.filter(f => f.status === status);
            }
            if (q) {
                filtered = filtered.filter(f =>
                    f.question.toLowerCase().includes(q) ||
                    f.category.toLowerCase().includes(q) ||
                    (f.tags || []).join(' ').toLowerCase().includes(q)
                );
            }
            renderTable(filtered);
        }

        async function toggleStatus(id) {
            try {
                const res = await fetch(`/dhanrubi/faq/toggle-status/${id}`, {
                    method: 'POST',
                    headers: { 'csrf-token': csrf, 'Content-Type': 'application/json' },
                    credentials: 'same-origin'
                });
                const data = await res.json();
                if (data.success) {
                    const faq = allFaqs.find(f => f._id === id);
                    const newStatus = data.newStatus.charAt(0).toUpperCase() + data.newStatus.slice(1);
                    if (faq) { faq.status = newStatus; }
                    const badge = document.getElementById(`badge-${id}`);
                    const btn = document.getElementById(`toggle-${id}`);
                    if (badge) { badge.textContent = newStatus; badge.className = `status-badge ${newStatus === 'Published' ? 'status-pub' : 'status-draft'}`; }
                    if (btn) { 
                        btn.innerHTML = `<i class="fa-solid fa-toggle-on"></i> ${newStatus === 'Published' ? 'Draft' : 'Publish'}`; 
                        btn.className = `action-btn-sm ${newStatus === 'Published' ? 'btn-toggle-draft' : 'btn-toggle-pub'} toggle-btn`; 
                    }
                    document.getElementById('countPublished').textContent = allFaqs.filter(f => f.status === 'Published').length;
                    document.getElementById('countDrafts').textContent = allFaqs.filter(f => f.status === 'Draft').length;
                } else { alert('Error: ' + data.message); }
            } catch(e) { console.error(e); alert('Network error'); }
        }

        async function deleteFaq(id) {
            // Confirmation dialog before deleting
            if (!confirm('⚠️ Delete this FAQ permanently? This cannot be undone.')) return;
            try {
                const res = await fetch('/api/dhanrubi/faq/' + id, {
                    method: 'DELETE',
                    headers: { 'csrf-token': csrf, 'Content-Type': 'application/json' },
                    credentials: 'same-origin'
                });
                const data = await res.json();
                if (data.success) {
                    showAlert('FAQ deleted.', 'success');
                    document.getElementById('row-' + id)?.remove();
                    allFaqs = allFaqs.filter(f => f._id !== id);
                    document.getElementById('countAll').textContent = allFaqs.length;
                    document.getElementById('countPublished').textContent = allFaqs.filter(f => f.status === 'Published').length;
                    document.getElementById('countDrafts').textContent = allFaqs.filter(f => f.status === 'Draft').length;
                } else { showAlert(data.message || 'Delete failed.', 'error'); }
            } catch(e) { showAlert('Network error.', 'error'); }
        }

        function showAlert(msg, type) {
            const box = document.getElementById('alertBox');
            box.textContent = msg;
            box.className = 'alert-msg ' + (type === 'success' ? 'alert-success' : 'alert-error');
            box.style.display = 'block';
            setTimeout(() => { box.style.display = 'none'; }, 4000);
        }

        function escHtml(str) {
            return String(str || '')
                .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Delegate listeners
        document.addEventListener('click', function(e) {
            if (e.target.closest('.delete-btn')) {
                const btn = e.target.closest('.delete-btn');
                deleteFaq(btn.getAttribute('data-id'));
            }
            if (e.target.closest('.toggle-btn')) {
                const btn = e.target.closest('.toggle-btn');
                toggleStatus(btn.getAttribute('data-id'));
            }
        });

        document.addEventListener('DOMContentLoaded', loadFaqs);
    </script>
</body>
</html>
