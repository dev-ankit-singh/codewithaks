<!-- Breadcrumb Schema (aligned with blog system) -->
<% if (typeof breadcrumbData !== 'undefined' && breadcrumbData && breadcrumbData.length > 0) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    <% breadcrumbData.forEach((item, index) => { %>
    {
      "@type": "ListItem",
      "position": <%= index + 1 %>,
      "name": <%- JSON.stringify(item.name) %>,
      "item": <%- JSON.stringify(item.url) %>
    }<%- index < breadcrumbData.length - 1 ? ',' : '' %>
    <% }) %>
  ]
}
</script>
<% } %>

<script>
  // Vote handler — AJAX with one-per-session guard
  const FAQ_ID = '<%= faq._id %>';
  const VOTED_KEY = 'voted_faq_' + FAQ_ID;

  (function initVote() {
    if (sessionStorage.getItem(VOTED_KEY)) {
      const ty = document.getElementById('voteThankyou');
      if (ty) {
        ty.style.display = 'block';
        ty.textContent = '✅ Thanks for your feedback!';
      }
    }
  })();

  async function submitVote(type) {
    const ty = document.getElementById('voteThankyou');
    if (sessionStorage.getItem(VOTED_KEY)) {
      ty.style.display = 'block';
      ty.textContent = 'ℹ️ You have already submitted feedback for this FAQ.';
      return;
    }

    const yes = document.getElementById('voteYes');
    const no  = document.getElementById('voteNo');
    yes.disabled = true; no.disabled = true;

    // Green / Red button animation immediately
    if (type === 'helpful') {
      yes.classList.add('green-active');
    } else {
      no.classList.add('red-active');
    }

    try {
      const res = await fetch('/api/faq-feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ faqId: FAQ_ID, feedback: type }),
        credentials: 'same-origin'
      });
      const data = await res.json();
      ty.style.display = 'block';
      if (data.success) {
        sessionStorage.setItem(VOTED_KEY, type);
        ty.textContent = '✅ Thanks for your feedback!';
      } else {
        ty.textContent = 'ℹ️ ' + (data.message || 'You have already submitted feedback for this FAQ.');
        sessionStorage.setItem(VOTED_KEY, 'voted');
      }
    } catch (e) {
      ty.style.display = 'block';
      ty.textContent = '⚠️ Could not submit feedback. Please try again.';
    }

    // After 5 seconds both buttons return to normal default style
    setTimeout(() => {
      yes.classList.remove('green-active');
      no.classList.remove('red-active');
      yes.disabled = false; no.disabled = false;
    }, 5000);
  }

  // Smooth scroll for TOC links
  document.querySelectorAll('.toc-list a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = document.querySelector(a.getAttribute('href'));
      if(target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });



  async function submitVote(type) {
  const ty = document.getElementById('voteThankyou');
  const yes = document.getElementById('voteYes');
  const no  = document.getElementById('voteNo');

  if (sessionStorage.getItem(VOTED_KEY)) {
    ty.style.display = 'block';
    ty.textContent = 'ℹ️ You have already submitted feedback for this FAQ.';
    return;
  }

  yes.disabled = true;
  no.disabled = true;

  if (type === 'helpful') {
    yes.classList.add('green-active');
    no.classList.remove('red-active');
  } else {
    no.classList.add('red-active');
    yes.classList.remove('green-active');
  }

  try {
    const res = await fetch('/api/faq-feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        faqId: FAQ_ID,
        feedback: type,
        page: window.location.pathname
      }),
      credentials: 'same-origin'
    });

    const data = await res.json();

    if (data.success) {
      sessionStorage.setItem(VOTED_KEY, type);
      ty.style.display = 'block';
      ty.textContent = '✅ Thanks for your feedback!';
    } else {
      ty.style.display = 'block';
      ty.textContent = '⚠️ ' + (data.message || 'Could not save feedback.');
    }
  } catch (err) {
    ty.style.display = 'block';
    ty.textContent = '⚠️ Could not submit feedback. Please try again.';
    yes.disabled = false;
    no.disabled = false;
  }
}

document.addEventListener('DOMContentLoaded', () => {

    const yesBtn = document.getElementById('voteYes');
    const noBtn = document.getElementById('voteNo');

    yesBtn.addEventListener('click', () => {
        submitVote('helpful');
    });

    noBtn.addEventListener('click', () => {
        submitVote('not_helpful');
    });

});
</script>

